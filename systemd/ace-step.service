[Unit]
Description=ACE-Step 1.5 WebUI (Gradio :7860)
Documentation=https://github.com/ace-step/ACE-Step-1.5
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ace
Group=ace
WorkingDirectory=/opt/ace-step
Environment=PYTHONUNBUFFERED=1
# Upstream-Default ist 127.0.0.1 (nur localhost) – explizite Flags, kein GRADIO_*-Env:
ExecStart=/opt/ace-step/.venv/bin/acestep --port 7860 --server-name 0.0.0.0
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
